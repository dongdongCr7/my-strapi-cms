{
  "collectionName": "components_navigation_nav_items",
  "info": {
    "displayName": "nav-item"
  },
  "options": {},
  "attributes": {
    "label": {
      "type": "string",
      "required": true
    },
    "linkType": {
      "type": "enumeration",
      "required": true,
      "default": "page",
      "enum": [
        "page",
        "product",
        "article",
        "external",
        "none"
      ]
    },
    "externalUrl": {
      "type": "string"
    },
    "openInNewTab": {
      "type": "boolean",
      "default": false
    },
    "icon": {
      "type": "string"
    },
    "children": {
      "type": "component",
      "component": "navigation.nav-item-child",
      "repeatable": true
    },
    "linkedPage": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::page.page"
    },
    "linkedProduct": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::product.product"
    }
  },
  "config": {}
}
