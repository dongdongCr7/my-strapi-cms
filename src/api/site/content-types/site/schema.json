{
  "kind": "collectionType",
  "collectionName": "sites",
  "info": {
    "singularName": "site",
    "pluralName": "sites",
    "displayName": "SiteSetting"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "site": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "brandName": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "brandAccent": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "brandSubline": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "parentBrand": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "parentBrandUrl": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "navLinks": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "shared.nav-link",
      "repeatable": true
    },
    "headerCtaText": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "headerCtaHref": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "footerDescription": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "footerColumns": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "footer.footer-column",
      "repeatable": true
    },
    "footerContact": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "component": "footer.footer-contact-info",
      "repeatable": false
    },
    "socialMedia": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "component": "shared.social-media-item",
      "repeatable": true
    },
    "newsletter": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "shared.text-item",
      "repeatable": false
    },
    "newsletterPlaceholder": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "newsletterButtonLabel": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "copyrightText": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "globalSeo": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "shared.seo-meta",
      "repeatable": false
    },
    "favicon": {
      "type": "media",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "languages": {
      "type": "json",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "categories": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::category.category",
      "mappedBy": "siteSetting"
    },
    "applications": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::application.application",
      "mappedBy": "siteSetting"
    },
    "products": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product.product",
      "mappedBy": "siteSetting"
    },
    "application_page": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::application-page.application-page",
      "mappedBy": "siteSetting"
    },
    "contactPage": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::contact-page.contact-page",
      "mappedBy": "siteSetting"
    },
    "over_view_page": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::over-view-page.over-view-page",
      "mappedBy": "siteSetting"
    },
    "productPage": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::product-page.product-page",
      "mappedBy": "siteSetting"
    },
    "resourcyPage": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::resourcy-page.resourcy-page",
      "mappedBy": "siteSetting"
    },
    "technologyPage": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::technology-page.technology-page",
      "mappedBy": "siteSetting"
    }
  }
}
