{
  "kind": "collectionType",
  "collectionName": "categories",
  "info": {
    "singularName": "category",
    "pluralName": "categories",
    "displayName": "Category"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "siteSetting": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::site.site",
      "inversedBy": "categories"
    },
    "productOrApplication": {
      "type": "enumeration",
      "enum": [
        "product",
        "application"
      ]
    },
    "categoryName": {
      "type": "string"
    },
    "slug": {
      "type": "uid"
    },
    "description": {
      "type": "text"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "imageAlt": {
      "type": "string"
    },
    "seo": {
      "type": "component",
      "component": "shared.seo-meta",
      "repeatable": false
    },
    "products": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product.product",
      "mappedBy": "category"
    },
    "applicationPage": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::application-page.application-page",
      "inversedBy": "categories"
    },
    "overViewPage": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::over-view-page.over-view-page",
      "inversedBy": "categories"
    },
    "productPage": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product-page.product-page",
      "inversedBy": "categories"
    }
  }
}
