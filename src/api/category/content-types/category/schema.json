{
  "kind": "collectionType",
  "collectionName": "categories",
  "info": {
    "singularName": "category",
    "pluralName": "categories",
    "displayName": "Category"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "site_setting": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::site-setting.site-setting",
      "inversedBy": "categories"
    },
    "productOrApplication": {
      "type": "enumeration",
      "enum": [
        "product",
        "application"
      ]
    },
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "description": {
      "type": "text"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "imageAlt": {
      "type": "string"
    },
    "order": {
      "type": "integer"
    },
    "products": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product.product",
      "mappedBy": "category"
    },
    "seo": {
      "type": "component",
      "component": "shared.seo-meta",
      "repeatable": false
    },
    "product_page": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product-page.product-page",
      "inversedBy": "categories"
    },
    "applications": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::application.application",
      "mappedBy": "category"
    },
    "over_view_page": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::over-view.over-view",
      "inversedBy": "categories"
    }
  }
}
