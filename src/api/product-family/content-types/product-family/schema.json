{
  "kind": "collectionType",
  "collectionName": "product_families",
  "info": {
    "singularName": "product-family",
    "pluralName": "product-families",
    "displayName": "product-family"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "tagline": {
      "type": "string"
    },
    "shortDescription": {
      "type": "text"
    },
    "longDescription": {
      "type": "richtext"
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "icon": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "sites": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::site.site",
      "inversedBy": "productFamilies"
    },
    "brands": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::brand.brand",
      "mappedBy": "productFamilies"
    },
    "keyFeatures": {
      "type": "component",
      "component": "shared.feature",
      "repeatable": true
    },
    "seo": {
      "type": "component",
      "component": "seo.meta",
      "repeatable": false
    },
    "sortOrder": {
      "type": "integer",
      "default": 0
    },
    "publishTime": {
      "type": "datetime"
    },
    "productSeries": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product-sery.product-sery",
      "inversedBy": "productFamilies"
    },
    "products": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product.product",
      "mappedBy": "productFamilies"
    },
    "technologies": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::technology.technology",
      "mappedBy": "productFamilies"
    }
  }
}
