{
  "kind": "collectionType",
  "collectionName": "accessories",
  "info": {
    "singularName": "accessory",
    "pluralName": "accessories",
    "displayName": "accessory"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "sites": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::site.site",
      "inversedBy": "accessories"
    },
    "category": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "Controller",
        "Power Supply",
        "Connector",
        "Profile",
        "Mounting Clip",
        "End Cap",
        "Other"
      ]
    },
    "model": {
      "type": "string",
      "unique": true
    },
    "shortDescription": {
      "type": "text"
    },
    "longDescription": {
      "type": "richtext"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "specifications": {
      "type": "component",
      "component": "shared.specification",
      "repeatable": true
    },
    "compatibleProducts": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product.product",
      "inversedBy": "accessories"
    },
    "accessories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::accessory.accessory",
      "inversedBy": "relatedAccessories"
    },
    "relatedAccessories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::accessory.accessory",
      "mappedBy": "accessories"
    },
    "seo": {
      "type": "component",
      "component": "seo.meta",
      "repeatable": false
    },
    "publishTime": {
      "type": "datetime"
    },
    "downloads": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::download.download",
      "mappedBy": "relatedAccessories"
    },
    "certifications": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::certification.certification",
      "mappedBy": "relatedAccessories"
    }
  }
}
