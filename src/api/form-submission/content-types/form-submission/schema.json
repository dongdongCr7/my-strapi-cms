{
  "kind": "collectionType",
  "collectionName": "form_submissions",
  "info": {
    "singularName": "form-submission",
    "pluralName": "form-submissions",
    "displayName": "form-submission"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "formType": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "contact",
        "sample-request",
        "quote",
        "general"
      ]
    },
    "name": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "string",
      "required": true
    },
    "company": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "message": {
      "type": "richtext"
    },
    "site": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::site.site",
      "inversedBy": "formSubmissions"
    },
    "products": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product.product",
      "inversedBy": "form_submissions"
    },
    "statu": {
      "type": "enumeration",
      "default": "new",
      "enum": [
        "new",
        "read",
        "replied",
        "closed",
        "spam"
      ]
    },
    "sourcePage": {
      "type": "string"
    },
    "ipAddress": {
      "type": "string"
    },
    "userAgent": {
      "type": "string"
    },
    "publishTime": {
      "type": "datetime"
    }
  }
}
