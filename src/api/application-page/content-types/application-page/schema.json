{
  "kind": "collectionType",
  "collectionName": "application_pages",
  "info": {
    "singularName": "application-page",
    "pluralName": "application-pages",
    "displayName": "ApplicationPage"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "siteSetting": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::site.site",
      "inversedBy": "application_page"
    },
    "hero": {
      "type": "component",
      "component": "shared.hero",
      "repeatable": false
    },
    "categories": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::category.category",
      "mappedBy": "applicationPage"
    },
    "applications": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::application.application",
      "mappedBy": "applicationPage"
    },
    "cta": {
      "type": "component",
      "component": "shared.text-item",
      "repeatable": false
    },
    "ctaBtn": {
      "type": "component",
      "component": "shared.btn",
      "repeatable": false
    }
  }
}
