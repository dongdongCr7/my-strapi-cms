{
  "kind": "collectionType",
  "collectionName": "product_series",
  "info": {
    "singularName": "product-sery",
    "pluralName": "product-series",
    "displayName": "product-sery"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "tagline": {
      "type": "string"
    },
    "shortDescription": {
      "type": "text"
    },
    "longDescription": {
      "type": "richtext"
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "sites": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::site.site",
      "inversedBy": "productSeries"
    },
    "productFamilies": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product-family.product-family",
      "mappedBy": "productSeries"
    },
    "keyFeatures": {
      "type": "component",
      "component": "shared.feature",
      "repeatable": true
    },
    "specifications": {
      "type": "component",
      "component": "shared.specification",
      "repeatable": true
    },
    "seo": {
      "type": "component",
      "component": "seo.meta",
      "repeatable": false
    },
    "publishTime": {
      "type": "datetime"
    },
    "products": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product.product",
      "mappedBy": "productSeries"
    },
    "technologies": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::technology.technology",
      "mappedBy": "productSeries"
    },
    "downloads": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::download.download",
      "mappedBy": "relatedSeries"
    }
  }
}
