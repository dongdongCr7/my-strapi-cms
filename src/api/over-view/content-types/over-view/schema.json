{
  "kind": "collectionType",
  "collectionName": "over_views",
  "info": {
    "singularName": "over-view",
    "pluralName": "over-views",
    "displayName": "OverViewPage"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "site_setting": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::site-setting.site-setting",
      "inversedBy": "over_view_page"
    },
    "hero": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "page.hero",
      "repeatable": false
    },
    "hero_tag": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "hero_btn": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "shared.btn",
      "repeatable": true
    },
    "hero_stats": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "page.stats",
      "repeatable": true
    },
    "hero_bar": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "home.trust-bar-item",
      "repeatable": true
    },
    "categories": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::category.category",
      "mappedBy": "over_view_page"
    },
    "page": {
      "type": "dynamiczone",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "components": [
        "shared.tag-item",
        "shared.item-feature",
        "page.features",
        "shared.btn",
        "page.stats",
        "page.hero"
      ]
    },
    "certifications": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::certification.certification",
      "mappedBy": "over_view_page"
    }
  }
}
