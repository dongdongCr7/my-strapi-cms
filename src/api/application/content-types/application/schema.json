{
  "kind": "collectionType",
  "collectionName": "applications",
  "info": {
    "singularName": "application",
    "pluralName": "applications",
    "displayName": "Application"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "site_setting": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::site-setting.site-setting",
      "inversedBy": "applications"
    },
    "name": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "description": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "images": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "shared.images",
      "repeatable": true
    },
    "trust_bar": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "home.trust-bar-item",
      "repeatable": true
    },
    "longDescription": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "tags": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "shared.tag-item",
      "repeatable": true
    },
    "features": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "shared.item-feature",
      "repeatable": true
    },
    "applications": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::application.application",
      "inversedBy": "relatedApplication"
    },
    "relatedApplication": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::application.application",
      "mappedBy": "applications"
    },
    "products": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product.product",
      "inversedBy": "applications"
    },
    "results": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "home.hero-stat",
      "repeatable": true
    },
    "CTA": {
      "type": "dynamiczone",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "components": [
        "shared.item-feature",
        "shared.btn"
      ]
    },
    "seo": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "shared.seo-meta",
      "repeatable": false
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "applications"
    },
    "application_page": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::application-page.application-page",
      "inversedBy": "applications"
    }
  }
}
