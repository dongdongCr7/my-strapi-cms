{
  "kind": "collectionType",
  "collectionName": "site_settings",
  "info": {
    "singularName": "site-setting",
    "pluralName": "site-settings",
    "displayName": "SiteSetting"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "site": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "brandName": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "brandAccent": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "brandSubline": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "parentBrand": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "parentBrandUrl": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "navLinks": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "shared.nav-link",
      "repeatable": true
    },
    "headerCtaText": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "headerCtaHref": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "footerDescription": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "footerColumns": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "footer.footer-column",
      "repeatable": true
    },
    "footerContact": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "footer.footer-contact-info",
      "repeatable": false
    },
    "newsletter": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "shared.item-feature",
      "repeatable": false
    },
    "newsletterPlaceholder": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": "Enter your email"
    },
    "newsletterButtonLabel": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": "Subscribe"
    },
    "copyrightText": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "globalSeo": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "shared.seo-meta",
      "repeatable": false
    },
    "favicon": {
      "type": "media",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "categories": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::category.category",
      "mappedBy": "site_setting"
    },
    "languages": {
      "type": "json",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "products": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product.product",
      "mappedBy": "site_setting"
    },
    "applications": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::application.application",
      "mappedBy": "site_setting"
    },
    "technology": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::technology.technology",
      "inversedBy": "site_setting"
    },
    "resourcy": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::resourcy.resourcy",
      "mappedBy": "site_setting"
    },
    "product_page": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::product-page.product-page",
      "mappedBy": "site_setting"
    },
    "application_page": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::application-page.application-page",
      "mappedBy": "site_setting"
    },
    "contact_page": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::contact-page.contact-page",
      "mappedBy": "site_setting"
    },
    "over_view_page": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::over-view.over-view",
      "mappedBy": "site_setting"
    }
  }
}
