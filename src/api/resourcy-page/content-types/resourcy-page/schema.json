    "hero": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "shared.hero",
      "repeatable": false
    },
    "intro": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "note": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "downloads": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::download.download",
      "mappedBy": "resourcyPage"
    },
    "cta": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "shared.text-item",
      "repeatable": false
    },
    "ctaBtn": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "shared.btn",
      "repeatable": false
