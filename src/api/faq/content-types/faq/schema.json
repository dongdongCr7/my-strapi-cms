{
  "kind": "collectionType",
  "collectionName": "faqs",
  "info": {
    "singularName": "faq",
    "pluralName": "faqs",
    "displayName": "faq"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "question": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "question",
      "required": true
    },
    "sites": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::site.site",
      "inversedBy": "faqs"
    },
    "answer": {
      "type": "richtext"
    },
    "category": {
      "type": "enumeration",
      "default": "General",
      "enum": [
        "Product",
        "Installation",
        "Technical",
        "Ordering",
        "Warranty",
        "General"
      ]
    },
    "relatedProducts": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product.product",
      "inversedBy": "faqs"
    },
    "relatedTechnologies": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::technology.technology",
      "mappedBy": "relatedFaqs"
    },
    "relatedApplications": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::application.application",
      "inversedBy": "faqs"
    },
    "relatedArticles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::article.article",
      "inversedBy": "faqs"
    },
    "isFeatured": {
      "type": "boolean",
      "default": false
    },
    "sortOrder": {
      "type": "integer",
      "default": 0
    },
    "publishTime": {
      "type": "datetime"
    },
    "industries": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::industry.industry",
      "inversedBy": "faqs"
    }
  }
}
